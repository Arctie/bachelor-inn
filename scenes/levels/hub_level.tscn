[sub_resource type="GDScript" id="GDScript_wggnu"]
script/source = "extends Panel
class_name UnitSlot

var unit_id: String = \"\"
@onready var garrison_unit_panel: UnitSlot = $\".\"
@onready var party_unit_panel: Panel = $\"../../../PartyMarginContainer/PartyGridContainer/PartyUnitPanel\"

@onready var garrison_unit_portrait: TextureRect = $GarrisonUnitPortrait
@onready var party_unit_portrait: TextureRect = $\"../../../PartyMarginContainer/PartyGridContainer/PartyUnitPanel/PartyUnitPortrait\"

func _ready() -> void:
	mouse_filter = Control.MOUSE_FILTER_STOP
	party_unit_portrait.mouse_filter = Control.MOUSE_FILTER_IGNORE 

func _get_drag_data(_at_position: Vector2) -> Variant:
	if party_unit_portrait.texture == null:
		print(\"PartyUnitPortrait is null.\")
		return
	var preview: TextureRect = TextureRect.new()
	preview.texutre = party_unit_portrait.texture
	preview.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	preview.custom_minimum_size = Vector2(90,90)
	preview.size = Vector2(90,90)
	preview.modulate = Color(1,1,1, 0.7)
	preview.positoin = -preview.size * 0.5
	print(\"Initiated drag with texture \", party_unit_portrait)
	set_drag_preview(preview)
	return party_unit_portrait

func _can_drop_data(at_position: Vector2, data: Variant) -> bool:
	return true

func _drop_data(at_position: Vector2, data: Variant) -> void:
	party_unit_portrait.texture = data.texture
"

